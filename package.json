{
  "name": "gakki",
  "version": "1.0.0",
  "description": "gakki",
  "main": "resources/cli.js",
  "bin": {
    "gakki": "resources/cli.js"
  },
  "type": "module",
  "scripts": {
    "postinstall": "pnpm patchright install chromium",
    "dev": "shadow-cljs watch :cli",
    "cli": "node resources/cli.js",
    "start": "shadow-cljs start",
    "stop": "shadow-cljs stop",
    "build:macos": "(cd macos/gakki && xcodebuild)",
    "build:release": "shadow-cljs release :cli :player",
    "check": "pnpm lint && pnpm test",
    "lint": "clojure -Sdeps '{:deps {clj-kondo {:mvn/version \"RELEASE\"}}}' -m clj-kondo.main --lint src --config .clj-kondo/config.edn",
    "old:clojure": "clojure -Sdeps '{:deps {antq/antq {:mvn/version \"RELEASE\"}}}' -m antq.core",
    "old": "pnpm old:clojure; pnpm outdated",
    "clean": "rm -rf resources/public/js/* && rm -rf target",
    "test:node": "shadow-cljs compile ci-esm && node target/cism/main.js",
    "test": "pnpm test:node"
  },
  "keywords": [
    "shadow-cljs",
    "reagent"
  ],
  "author": "Daniel Leong",
  "license": "MIT",
  "devDependencies": {
    "node": "24",
    "shadow-cljs": "^2.14.5"
  },
  "dependencies": {
    "audify": "^1.10.0",
    "chalk": "^6.0.1",
    "color-convert": "^3.1.3",
    "create-react-class": "^15.6.3",
    "discord-rpc": "4.0.1",
    "env-paths": "^4.0.0",
    "ffmpeg-static": "^5.3.0",
    "figures": "^6.1.0",
    "highlight.js": "11.0.1",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "keytar": "^7.0.0",
    "node-fetch": "^3.3.2",
    "patchright": "^1.63.0",
    "prism-media": "^1.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "youtubei.js": "^18.1.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "discord-rpc": "patches/discord-rpc.patch"
    }
  }
}
